<launch>
  <!-- 到位自动读码：相机读码节点 + 串口读码器 + 到位触发节点（不含相机/视觉/控制）。
       前提：另开终端跑 ov13855_marker_tracking.launch（相机 + AprilTag + 控制），layout 两边必须相同。
       不要同时运行 DroneVision（共用 /dev/ttyS1）。可选值见下面的 doc。 -->
  <arg name="mode" default=""
       doc="读码器：留空（默认，用 config_file 里的 mode，现为 both）/ camera（只相机）/ serial（只串口读码器）/ both（先相机后读码器）" />
  <arg name="layout" default="qr_top_tag_bottom"
       doc="标签版式，必须与 ov13855_marker_tracking.launch 相同：qr_top_tag_bottom（默认）/ dm_top_tag_bottom / drone_vision_default" />
  <arg name="save_frames" default="off"
       doc="相机读码存图：off（不存，默认）/ failed（只存失败）/ all（都存）；每次一个目录 save_dir/时间_结果/" />
  <arg name="save_dir" default="~/barcode_frames"
       doc="存图目录，attempts.csv 也在这里" />
  <arg name="config_file" default="$(find barcode_arrival_trigger)/config/barcode_arrival_trigger.yaml"
       doc="到位触发节点参数文件（话题、门控、mode 等）" />

  <include file="$(find barcode_reader_camera)/launch/barcode_reader_camera.launch">
    <arg name="layout" value="$(arg layout)" />
    <arg name="save_frames" value="$(arg save_frames)" />
    <arg name="save_dir" value="$(arg save_dir)" />
  </include>
  <include file="$(find barcode_reader_serial)/launch/barcode_reader.launch" />
  <include file="$(find barcode_arrival_trigger)/launch/barcode_arrival_trigger.launch">
    <arg name="config_file" value="$(arg config_file)" />
    <arg name="mode" value="$(arg mode)" />
  </include>
</launch>
