<launch>
  <arg name="config_file" default="$(find barcode_reader_camera)/config/barcode_reader_camera.yaml" />
  <!-- 标签版式：config/layouts/<layout>.yaml（tag 边长、标签几何、expected_codes），视觉和读码共用 -->
  <arg name="layout" default="qr_top_tag_bottom" />
  <arg name="layout_file" default="$(find barcode_reader_camera)/config/layouts/$(arg layout).yaml" />
  <arg name="require_tag" default="true" />
  <arg name="log_strategies" default="false" />
  <!-- output：screen 打到终端；log 时 INFO 只进 ~/.ros/log，WARN/ERROR 仍打到终端（manual_read 用来让终端只留汇总） -->
  <arg name="output" default="screen" />
  <node pkg="barcode_reader_camera" type="barcode_reader_camera_node" name="barcode_reader_camera" output="$(arg output)">
    <param name="config_file" value="$(arg config_file)" />
    <param name="layout_file" value="$(arg layout_file)" />
    <param name="require_tag" value="$(arg require_tag)" />
    <param name="log_strategies" value="$(arg log_strategies)" />
    <param name="image_topic" value="/ov13855/image_raw" />
    <param name="camera_info_topic" value="/ov13855/camera_info" />
    <param name="pose_topic" value="/front_marker/pose" />
  </node>
</launch>
