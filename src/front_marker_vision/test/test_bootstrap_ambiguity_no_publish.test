<launch>
  <node pkg="front_marker_vision"
        type="front_marker_vision_node"
        name="front_marker_bootstrap_ambiguity_test_vision"
        clear_params="true"
        output="screen">
    <param name="image_topic" value="/test_bootstrap_ambiguity/image" />
    <param name="camera_info_topic" value="/test_bootstrap_ambiguity/camera_info" />
    <param name="pose_topic" value="/test_bootstrap_ambiguity/pose" />
    <param name="transform_debug_topic" value="/test_bootstrap_ambiguity/transform_debug" />
    <param name="processing_time_topic" value="/test_bootstrap_ambiguity/processing_time" />
    <param name="annotated_image_topic" value="/test_bootstrap_ambiguity/annotated" />
    <param name="status_topic" value="/test_bootstrap_ambiguity/status" />
    <param name="aruco_dictionary" value="DICT_5X5_1000" />
    <param name="target_marker_id" value="33" />
    <param name="target_marker_size_m" value="0.070" />
    <param name="publish_marker_tf" value="true" />
    <param name="marker_frame" value="test_bootstrap_front_marker" />
    <param name="enable_contour_gate" value="false" />
    <param name="enable_roi" value="false" />
    <param name="pose_solver" value="IPPE_SQUARE" />
    <param name="ippe_ambiguity_gap_px" value="1000.0" />
    <param name="ippe_reference_confirm_frames" value="3" />
    <param name="ippe_reference_max_rotation_step_rad" value="0.35" />
    <param name="ippe_reference_max_translation_step_m" value="0.10" />
    <param name="pose_continuity_timeout_sec" value="0.20" />
    <param name="publish_annotated" value="false" />
  </node>

  <test test-name="bootstrap_ambiguity_no_publish"
        pkg="front_marker_vision"
        type="test_bootstrap_ambiguity_no_publish.py"
        time-limit="25.0" />
</launch>
