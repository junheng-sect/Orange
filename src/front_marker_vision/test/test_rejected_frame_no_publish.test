<launch>
  <node pkg="front_marker_vision"
        type="front_marker_vision_node"
        name="front_marker_rejection_test_vision"
        clear_params="true"
        output="screen">
    <param name="image_topic" value="/test_front_marker/image" />
    <param name="camera_info_topic" value="/test_front_marker/camera_info" />
    <param name="pose_topic" value="/test_front_marker/pose" />
    <param name="transform_debug_topic" value="/test_front_marker/transform_debug" />
    <param name="processing_time_topic" value="/test_front_marker/processing_time_ms" />
    <param name="annotated_image_topic" value="/test_front_marker/annotated" />
    <param name="status_topic" value="/test_front_marker/status" />
    <param name="aruco_dictionary" value="DICT_5X5_1000" />
    <param name="target_marker_id" value="33" />
    <param name="target_marker_size_m" value="0.070" />
    <param name="publish_marker_tf" value="true" />
    <param name="marker_frame" value="rejected_front_marker" />
    <param name="enable_contour_gate" value="true" />
    <param name="pose_solver" value="IPPE_SQUARE" />
    <!-- 8-bit outside-inside contrast cannot reach 300, so a detected marker must be rejected. -->
    <param name="min_edge_contrast" value="300.0" />
    <!-- publish_annotated is intentionally omitted to test the true default. -->
    <param name="annotated_rate_hz" value="0.0" />
  </node>

  <node pkg="front_marker_vision"
        type="front_marker_vision_node"
        name="front_marker_annotation_disabled_test"
        clear_params="true"
        output="log">
    <param name="image_topic" value="/test_front_marker/disabled_image" />
    <param name="camera_info_topic" value="/test_front_marker/disabled_camera_info" />
    <param name="pose_topic" value="/test_front_marker/disabled_pose" />
    <param name="transform_debug_topic" value="/test_front_marker/disabled_transform" />
    <param name="processing_time_topic" value="/test_front_marker/disabled_processing" />
    <param name="annotated_image_topic" value="/test_front_marker/disabled_annotated" />
    <param name="status_topic" value="/test_front_marker/disabled_status" />
    <param name="publish_annotated" value="false" />
  </node>

  <test test-name="rejected_frame_no_publish"
        pkg="front_marker_vision"
        type="test_rejected_frame_no_publish.py"
        time-limit="15.0" />
</launch>
