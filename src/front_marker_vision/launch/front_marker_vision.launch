<launch>
  <!-- 视觉参数统一在 YAML 中维护。 -->
  <arg name="config_file" default="$(find front_marker_vision)/config/front_marker_vision.yaml" />

  <node pkg="front_marker_vision"
        type="front_marker_vision_node"
        name="front_marker_vision_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>
</launch>
