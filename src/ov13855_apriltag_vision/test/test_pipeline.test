<launch>
 <node pkg="ov13855_apriltag_vision" type="ov13855_apriltag_vision_node" name="ov13855_test_vision" output="screen">
  <param name="image_topic" value="/ov13855_test/image" />
  <param name="camera_info_topic" value="/ov13855_test/info" />
  <param name="pose_topic" value="/ov13855_test/pose" />
  <param name="transform_debug_topic" value="/ov13855_test/matrix" />
  <param name="processing_time_topic" value="/ov13855_test/time" />
  <param name="status_topic" value="/ov13855_test/status" />
  <param name="marker_frame" value="ov13855_test_marker" />
  <param name="publish_detections" value="true" />
  <param name="selection_mode" value="largest" />
  <param name="publish_annotated" value="false" />
  <param name="preview_image_topic" value="/ov13855_test/preview" />
  <param name="preview_max_dimension" value="400" />
  <param name="preview_rate_hz" value="0.0" />
 </node>
 <test test-name="ov13855_pipeline" pkg="ov13855_apriltag_vision" type="test_pipeline.py" time-limit="60" />
</launch>
