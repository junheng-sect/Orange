<launch>
  <!-- 视觉参数统一在 YAML 中维护；layout_file 非空时再叠加标签版式文件（覆盖 target_marker_size_m）。 -->
  <arg name="config_file" default="$(find ov13855_apriltag_vision)/config/ov13855_apriltag_vision.yaml" />
  <arg name="layout_file" default="" />

  <node pkg="ov13855_apriltag_vision"
        type="ov13855_apriltag_vision_node"
        name="ov13855_apriltag_vision_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <rosparam if="$(eval arg('layout_file') != '')"
              command="load" file="$(arg layout_file)" />
  </node>
</launch>
