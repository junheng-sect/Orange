<launch>
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="test_fixed_map_to_marker"
        args="1 0 0.1 0.5 -0.5 -0.5 0.5 test_fixed_map test_fixed_marker" />
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="test_fixed_base_to_camera"
        args="0 0 0 -0.5 0.5 -0.5 0.5 test_fixed_base test_fixed_camera" />

  <node pkg="seeker_visualization"
        type="fixed_marker_base_tf_node.py"
        name="test_fixed_marker_base_tf_node"
        clear_params="true"
        output="screen">
    <param name="pose_topic" value="/test_fixed_marker/pose" />
    <param name="map_frame" value="test_fixed_map" />
    <param name="base_frame" value="test_fixed_base" />
    <param name="camera_frame" value="test_fixed_camera" />
    <param name="marker_frame" value="test_fixed_marker" />
    <param name="tf_lookup_timeout_sec" value="0.05" />
  </node>

  <!-- This second node must never publish because missing_base has no camera TF. -->
  <node pkg="seeker_visualization"
        type="fixed_marker_base_tf_node.py"
        name="test_fixed_marker_missing_tf_node"
        clear_params="true"
        output="screen">
    <param name="pose_topic" value="/test_fixed_marker/pose" />
    <param name="map_frame" value="test_fixed_map" />
    <param name="base_frame" value="test_missing_base" />
    <param name="camera_frame" value="test_fixed_camera" />
    <param name="marker_frame" value="test_fixed_marker" />
    <param name="tf_lookup_timeout_sec" value="0.02" />
  </node>

  <test test-name="fixed_marker_base_tf"
        pkg="seeker_visualization"
        type="test_fixed_marker_base_tf.py"
        time-limit="20.0" />
</launch>
