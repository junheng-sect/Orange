<launch>
  <!-- 可视化入口：保留启动开关与 RViz 场景选择；运行参数统一在 YAML 中维护。
       保留既有行为差异：start_tracking=true 时叠加跟踪管道并把控制场景配置设为
       关闭 yaw 控制与控制输出。 -->
  <arg name="start_tracking" default="true" />
  <arg name="show_frame_labels" default="true" />
  <arg name="rviz_config" default="$(find seeker_visualization)/rviz/front_marker_tf.rviz" />
  <arg name="config_file" default="$(find seeker_visualization)/config/seeker_visualization.yaml" />
  <arg name="control_scene_config" default="$(find front_marker_control)/config/front_marker_control_rviz.yaml" />

  <!-- Full pipeline owns the camera driver, camera static TF and dynamic marker TF. -->
  <include file="$(find front_marker_control)/launch/front_marker_tracking.launch"
           if="$(arg start_tracking)">
    <arg name="control_scene_config" value="$(arg control_scene_config)" />
  </include>

  <!-- With start_tracking:=false the full tracking pipeline must already be
       running elsewhere and owns the camera and marker TF edges. -->
  <node pkg="seeker_visualization"
        type="mavros_odom_tf_node.py"
        name="mavros_odom_tf_node"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>

  <!-- RViz TF names cannot be offset per frame; publish readable labels separately. -->
  <node pkg="seeker_visualization"
        type="tf_frame_labels_node.py"
        name="tf_frame_labels_node"
        output="screen"
        if="$(arg show_frame_labels)">
    <rosparam command="load" file="$(arg config_file)" />
  </node>

  <node pkg="rviz"
        type="rviz"
        name="front_marker_rviz"
        args="-d $(arg rviz_config)"
        output="screen" />
</launch>
