<launch>
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="pos_hold_camera_tf"
        args="0 0 0 -0.5 0.5 -0.5 0.5 drone_base usb_camera_optical_frame" />

  <node pkg="front_marker_control"
        type="front_marker_control_node"
        name="pos_hold_front_marker_control"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find front_marker_control)/config/front_marker_control.yaml" />
    <param name="pose_topic" value="/test_pos_hold/pose" />
    <param name="state_topic" value="/test_pos_hold/state" />
    <param name="setpoint_raw_topic" value="/test_pos_hold/actual" />
    <param name="odom_topic" value="/test_pos_hold/odom" />
    <param name="position_error_topic" value="/test_pos_hold/error" />
    <param name="yaw_error_topic" value="/test_pos_hold/yaw_error" />
    <param name="command_topic" value="/test_pos_hold/cmd_vel" />
    <param name="setpoint_preview_topic" value="/test_pos_hold/preview" />
    <param name="status_topic" value="/test_pos_hold/status" />
    <param name="base_frame" value="drone_base" />
    <param name="kp_x" value="0.5" />
    <param name="kp_y" value="0.5" />
    <param name="kp_z" value="0.5" />
    <param name="kp_yaw" value="0.0" />
    <param name="enable_setpoint_output" value="true" />
    <param name="enable_yaw_control" value="true" />
    <param name="yaw_mode" value="marker" />
    <param name="enable_position_hold" value="true" />
    <param name="yaw_sampling_duration_sec" value="0.6" />
    <param name="aligned_hold_sec" value="0.3" />
    <param name="pos_exit_hold_sec" value="0.3" />
    <!-- 插值窗口小，便于用稀疏 odom 验证“无匹配不切换”。 -->
    <param name="odom_interp_gap_max_sec" value="0.10" />
    <param name="retreat_recover_distance_m" value="0.70" />
    <param name="retreat_velocity_x" value="-0.10" />
  </node>

  <test test-name="position_hold"
        pkg="front_marker_control"
        type="test_position_hold.py"
        time-limit="180.0" />
</launch>
