<launch>
  <arg name="camera_name" default="ov9281_640x480" />
  <arg name="camera_info_url" default="file://$(find ov9281_usb_cam)/config/ov9281_640x480.yaml" />
  <arg name="image_width" default="640" />
  <arg name="image_height" default="480" />
  <arg name="framerate" default="30" />
  <arg name="camera_output_encoding" default="mono8" />
  <arg name="base_frame" default="base_link" />
  <arg name="camera_frame" default="usb_camera_optical_frame" />
  <arg name="target_marker_id" default="33" />
  <arg name="target_marker_size_m" default="0.070" />
  <arg name="publish_marker_tf" default="true" />
  <arg name="marker_frame" default="front_marker" />
  <arg name="pose_solver" default="IPPE_SQUARE" />
  <arg name="enable_roi" default="true" />
  <arg name="min_marker_perimeter_rate" default="0.075" />
  <arg name="target_body_x" default="0.8" />
  <arg name="target_body_y" default="0.0" />
  <arg name="target_body_z" default="0.0" />
  <arg name="kp_x" default="1.50" />
  <arg name="kp_y" default="1.50" />
  <arg name="kp_z" default="1.00" />
  <arg name="velocity_deadband_enter" default="0.02" />
  <arg name="velocity_deadband" default="0.03" />
  <arg name="publish_annotated" default="true" />
  <arg name="annotated_rate_hz" default="5.0" />
  <arg name="enable_yaw_control" default="true" />
  <arg name="enable_setpoint_output" default="false" />
  <arg name="max_accel" default="0.5" />
  <arg name="loss_decel" default="1.0" />
  <arg name="pose_timeout_sec" default="0.1" />
  <arg name="max_pose_latency_sec" default="0.5" />
  <arg name="filter_dt_max_sec" default="0.5" />

  <include file="$(find ov9281_usb_cam)/launch/ov9281.launch">
    <arg name="camera_name" value="$(arg camera_name)" />
    <arg name="camera_info_url" value="$(arg camera_info_url)" />
    <arg name="image_width" value="$(arg image_width)" />
    <arg name="image_height" value="$(arg image_height)" />
    <arg name="framerate" value="$(arg framerate)" />
    <arg name="camera_frame" value="$(arg camera_frame)" />
    <arg name="output_encoding" value="$(arg camera_output_encoding)" />
  </include>

  <include file="$(find front_marker_control)/launch/front_camera_tf.launch">
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="camera_frame" value="$(arg camera_frame)" />
  </include>

  <include file="$(find front_marker_vision)/launch/front_marker_vision.launch">
    <arg name="target_marker_id" value="$(arg target_marker_id)" />
    <arg name="target_marker_size_m" value="$(arg target_marker_size_m)" />
    <arg name="publish_marker_tf" value="$(arg publish_marker_tf)" />
    <arg name="marker_frame" value="$(arg marker_frame)" />
    <arg name="pose_solver" value="$(arg pose_solver)" />
    <arg name="enable_roi" value="$(arg enable_roi)" />
    <arg name="min_marker_perimeter_rate" value="$(arg min_marker_perimeter_rate)" />
    <arg name="publish_annotated" value="$(arg publish_annotated)" />
    <arg name="annotated_rate_hz" value="$(arg annotated_rate_hz)" />
  </include>

  <include file="$(find front_marker_control)/launch/front_marker_control.launch">
    <arg name="base_frame" value="$(arg base_frame)" />
    <arg name="target_body_x" value="$(arg target_body_x)" />
    <arg name="target_body_y" value="$(arg target_body_y)" />
    <arg name="target_body_z" value="$(arg target_body_z)" />
    <arg name="kp_x" value="$(arg kp_x)" />
    <arg name="kp_y" value="$(arg kp_y)" />
    <arg name="kp_z" value="$(arg kp_z)" />
    <arg name="velocity_deadband_enter" value="$(arg velocity_deadband_enter)" />
    <arg name="velocity_deadband" value="$(arg velocity_deadband)" />
    <arg name="enable_yaw_control" value="$(arg enable_yaw_control)" />
    <arg name="enable_setpoint_output" value="$(arg enable_setpoint_output)" />
    <arg name="max_accel" value="$(arg max_accel)" />
    <arg name="loss_decel" value="$(arg loss_decel)" />
    <arg name="pose_timeout_sec" value="$(arg pose_timeout_sec)" />
    <arg name="max_pose_latency_sec" value="$(arg max_pose_latency_sec)" />
    <arg name="filter_dt_max_sec" value="$(arg filter_dt_max_sec)" />
  </include>
</launch>
