<launch>
  <arg name="base_frame" default="base_link" />
  <arg name="camera_frame" default="usb_camera_optical_frame" />

  <!-- Existing calibrated mounting convention: base FLU to USB camera optical frame. -->
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="front_camera_static_transform"
        args="0 0 0 -0.5 0.5 -0.5 0.5 $(arg base_frame) $(arg camera_frame)" />
</launch>
