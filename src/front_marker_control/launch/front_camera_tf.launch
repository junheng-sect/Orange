<launch>
  <!-- 相机静态 TF 数值统一在 YAML 中维护。 -->
  <arg name="config_file" default="$(find front_marker_control)/config/front_camera_tf.yaml" />

  <node pkg="front_marker_control"
        type="front_camera_static_tf_node.py"
        name="front_camera_static_transform"
        output="screen">
    <rosparam command="load" file="$(arg config_file)" />
  </node>
</launch>
