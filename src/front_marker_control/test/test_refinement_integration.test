<launch>
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="refine_camera_tf"
        args="0 0 0 -0.5 0.5 -0.5 0.5 base_link usb_camera_optical_frame" />

  <node pkg="front_marker_control"
        type="front_marker_control_node"
        name="refine_front_marker_control"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find front_marker_control)/config/front_marker_control.yaml" />
    <param name="fixed_yaw_target_topic" value="/test_refine/fixed_yaw" />
    <param name="pose_topic" value="/test_refine/pose" />
    <param name="state_topic" value="/test_refine/state" />
    <param name="setpoint_raw_topic" value="/test_refine/actual" />
    <param name="odom_topic" value="/test_refine/odom" />
    <param name="position_error_topic" value="/test_refine/error" />
    <param name="yaw_error_topic" value="/test_refine/yaw_error" />
    <param name="command_topic" value="/test_refine/cmd_vel" />
    <param name="setpoint_preview_topic" value="/test_refine/preview" />
    <param name="status_topic" value="/test_refine/status" />
    <param name="control_mode_topic" value="/test_refine/control_mode" />
    <param name="base_frame" value="base_link" />
    <param name="kp_x" value="0.5" />
    <param name="kp_y" value="0.5" />
    <param name="kp_z" value="0.5" />
    <param name="kp_yaw" value="0.0" />
    <param name="enable_setpoint_output" value="true" />
    <param name="enable_yaw_control" value="true" />
    <param name="enable_position_hold" value="true" />
    <param name="yaw_sampling_duration_sec" value="0.6" />
    <param name="aligned_hold_sec" value="0.3" />
    <param name="pos_exit_hold_sec" value="0.3" />
    <!-- 插值窗口小，便于用稀疏 odom 验证“无匹配不切换”。 -->
    <param name="odom_interp_gap_max_sec" value="0.10" />
    <param name="retreat_recover_distance_m" value="0.70" />
    <param name="retreat_velocity_x" value="-0.10" />
  </node>

  <test test-name="refinement_integration"
        pkg="front_marker_control"
        type="test_refinement_integration.py"
        time-limit="180.0" />
</launch>
