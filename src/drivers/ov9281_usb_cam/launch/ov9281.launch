<launch>
  <!-- 运行参数统一在 YAML 中维护：先公共配置，后场景差异配置。 -->
  <arg name="run_config" default="$(find ov9281_usb_cam)/config/ov9281_common.yaml" />
  <!-- 场景差异（默认普通相机 rgb8；跟踪入口传 ov9281_mono8.yaml） -->
  <arg name="scene_config" default="$(find ov9281_usb_cam)/config/ov9281_rgb8.yaml" />

  <node pkg="ov9281_usb_cam"
        type="ov9281_usb_cam_node"
        name="usb_cam"
        output="log">
    <rosparam command="load" file="$(arg run_config)" />
    <rosparam command="load" file="$(arg scene_config)" />
    <remap from="~image_raw" to="/usb_cam/image_raw" />
    <remap from="~camera_info" to="/usb_cam/camera_info" />
  </node>
</launch>
