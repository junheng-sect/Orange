<launch>
  <arg name="map_pcd"/>
  <arg name="seed_map_odom" default="[]"/>
  <arg name="start_standalone_dll" default="true"/>
  <arg name="seed_not_before_ns" default="0"/>
  <arg name="config" default="$(find fastlio_dll)/config/indoor.yaml"/>

  <param name="/use_sim_time" value="true"/>
  <include file="$(find fast_lio)/launch/mapping_mid360s.launch">
    <arg name="rviz" value="false"/>
  </include>
  <include file="$(find fastlio_gravity_bridge)/launch/gravity_bridge.launch">
    <arg name="send_to_mavros" value="false"/>
  </include>

  <node if="$(arg start_standalone_dll)" pkg="fastlio_dll" type="fastlio_dll_node" name="fastlio_dll"
        output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="map_pcd" type="str" value="$(arg map_pcd)"/>
    <param name="seed_not_before_ns" type="str" value="$(arg seed_not_before_ns)"/>
    <rosparam param="seed_map_odom" subst_value="true">$(arg seed_map_odom)</rosparam>
  </node>
</launch>
