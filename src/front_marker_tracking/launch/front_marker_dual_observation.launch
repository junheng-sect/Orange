<launch>
  <!-- LEGACY: calibrated 640x768 front stereo observation; not used by the
       default USB-camera tracking launch. -->
  <arg name="aruco_dictionary" default="DICT_5X5_1000" />
  <arg name="target_marker_id" default="33" />
  <arg name="target_marker_size_m" default="0.193" />
  <arg name="publish_left_annotated" default="false" />
  <arg name="publish_right_annotated" default="false" />
  <arg name="annotated_rate_hz" default="5.0" />

  <!-- Observation-only launch: no PID, preview, setpoint, arming, or mode services. -->
  <node pkg="front_marker_tracking"
        type="front_marker_detector_node"
        name="front_marker_detector_left"
        output="screen">
    <param name="image_topic" value="/front/left/image_raw" />
    <param name="camera_info_topic" value="/front/left/camera_info" />
    <param name="transform_topic" value="/front_marker_tracking/left/transform_camera_marker" />
    <param name="annotated_image_topic" value="/front_marker_tracking/left/image_annotated" />
    <param name="status_topic" value="/front_marker_tracking/left/detector_status" />
    <param name="aruco_dictionary" value="$(arg aruco_dictionary)" />
    <param name="target_marker_id" value="$(arg target_marker_id)" />
    <param name="target_marker_size_m" value="$(arg target_marker_size_m)" />
    <param name="expected_image_width" value="640" />
    <param name="expected_image_height" value="768" />
    <param name="expected_camera_frame" value="cam0" />
    <param name="enable_contour_gate" value="false" />
    <param name="corner_refinement_method" value="NONE" />
    <param name="pose_solver" value="LEGACY" />
    <param name="publish_annotated" value="$(arg publish_left_annotated)" />
    <param name="annotated_rate_hz" value="$(arg annotated_rate_hz)" />
  </node>

  <node pkg="front_marker_tracking"
        type="front_marker_detector_node"
        name="front_marker_detector_right"
        output="screen">
    <param name="image_topic" value="/front/right/image_raw" />
    <param name="camera_info_topic" value="/front/right/camera_info" />
    <param name="transform_topic" value="/front_marker_tracking/right/transform_camera_marker" />
    <param name="annotated_image_topic" value="/front_marker_tracking/right/image_annotated" />
    <param name="status_topic" value="/front_marker_tracking/right/detector_status" />
    <param name="aruco_dictionary" value="$(arg aruco_dictionary)" />
    <param name="target_marker_id" value="$(arg target_marker_id)" />
    <param name="target_marker_size_m" value="$(arg target_marker_size_m)" />
    <param name="expected_image_width" value="640" />
    <param name="expected_image_height" value="768" />
    <param name="expected_camera_frame" value="cam1" />
    <param name="enable_contour_gate" value="true" />
    <param name="corner_refinement_method" value="SUBPIX" />
    <param name="pose_solver" value="IPPE_SQUARE" />
    <param name="publish_annotated" value="$(arg publish_right_annotated)" />
    <param name="annotated_rate_hz" value="$(arg annotated_rate_hz)" />
  </node>

  <node pkg="front_marker_tracking"
        type="front_marker_base_transform_node"
        name="front_marker_base_transform_left"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find front_marker_tracking)/config/front_left_cam0.yaml" />
    <param name="input_transform_topic" value="/front_marker_tracking/left/transform_camera_marker" />
    <param name="output_transform_topic" value="/front_marker_tracking/left/transform_base_marker" />
    <param name="output_pose_topic" value="/front_marker_tracking/left/marker_pose_base" />
    <param name="status_topic" value="/front_marker_tracking/left/base_transform_status" />
    <param name="expected_camera_frame" value="cam0" />
    <param name="base_frame" value="base_link" />
    <param name="target_marker_id" value="$(arg target_marker_id)" />
  </node>

  <node pkg="front_marker_tracking"
        type="front_marker_base_transform_node"
        name="front_marker_base_transform_right"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find front_marker_tracking)/config/front_right_cam1.yaml" />
    <param name="input_transform_topic" value="/front_marker_tracking/right/transform_camera_marker" />
    <param name="output_transform_topic" value="/front_marker_tracking/right/transform_base_marker" />
    <param name="output_pose_topic" value="/front_marker_tracking/right/marker_pose_base" />
    <param name="status_topic" value="/front_marker_tracking/right/base_transform_status" />
    <param name="expected_camera_frame" value="cam1" />
    <param name="base_frame" value="base_link" />
    <param name="target_marker_id" value="$(arg target_marker_id)" />
  </node>
</launch>
