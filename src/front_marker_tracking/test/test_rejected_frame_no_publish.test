<launch>
  <node pkg="front_marker_tracking"
        type="front_marker_detector_node"
        name="front_marker_rejection_test_detector"
        clear_params="true"
        output="screen">
    <param name="image_topic" value="/test_front_marker/image" />
    <param name="camera_info_topic" value="/test_front_marker/camera_info" />
    <param name="transform_topic" value="/test_front_marker/transform" />
    <param name="annotated_image_topic" value="/test_front_marker/annotated" />
    <param name="status_topic" value="/test_front_marker/status" />
    <param name="aruco_dictionary" value="DICT_5X5_1000" />
    <param name="target_marker_id" value="33" />
    <param name="target_marker_size_m" value="0.070" />
    <param name="expected_image_width" value="640" />
    <param name="expected_image_height" value="480" />
    <param name="expected_camera_frame" value="usb_camera_optical_frame" />
    <param name="enable_contour_gate" value="true" />
    <param name="corner_refinement_method" value="SUBPIX" />
    <param name="pose_solver" value="IPPE_SQUARE" />
    <!-- 8-bit outside-inside contrast cannot reach 300, so a detected marker must be rejected. -->
    <param name="min_edge_contrast" value="300.0" />
    <param name="publish_annotated" value="true" />
    <param name="annotated_rate_hz" value="0.0" />
  </node>

  <test test-name="rejected_frame_no_publish"
        pkg="front_marker_tracking"
        type="test_rejected_frame_no_publish.py"
        time-limit="15.0" />
</launch>
