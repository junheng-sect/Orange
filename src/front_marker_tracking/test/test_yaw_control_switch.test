<launch>
  <node pkg="front_marker_tracking"
        type="front_marker_tracking_node"
        name="yaw_control_off_tracking"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find front_marker_tracking)/config/front_usb_camera_aligned.yaml" />
    <param name="transform_topic" value="/test_yaw_control/off/transform" />
    <param name="state_topic" value="/test_yaw_control/off/state" />
    <param name="setpoint_raw_topic" value="/test_yaw_control/off/actual_setpoint" />
    <param name="setpoint_preview_topic" value="/test_yaw_control/off/preview" />
    <param name="enable_setpoint_output" value="false" />
    <param name="enable_yaw_control" value="false" />
    <param name="aligned_hold_sec" value="0.25" />
    <remap from="/front_marker_tracking/marker_pose_camera" to="/test_yaw_control/off/marker_pose_camera" />
    <remap from="/front_marker_tracking/position_error_camera" to="/test_yaw_control/off/position_error_camera" />
    <remap from="/front_marker_tracking/yaw_error" to="/test_yaw_control/off/yaw_error" />
    <remap from="/front_marker_tracking/error_flu" to="/test_yaw_control/off/error_flu" />
    <remap from="/front_marker_tracking/error_flu_filtered" to="/test_yaw_control/off/error_flu_filtered" />
    <remap from="/front_marker_tracking/cmd_vel_camera" to="/test_yaw_control/off/cmd_vel_camera" />
    <remap from="/front_marker_tracking/cmd_vel_flu" to="/test_yaw_control/off/cmd_vel_flu" />
    <remap from="/front_marker_tracking/status" to="/test_yaw_control/off/status" />
  </node>

  <node pkg="front_marker_tracking"
        type="front_marker_tracking_node"
        name="yaw_control_on_tracking"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find front_marker_tracking)/config/front_usb_camera_aligned.yaml" />
    <param name="transform_topic" value="/test_yaw_control/on/transform" />
    <param name="state_topic" value="/test_yaw_control/on/state" />
    <param name="setpoint_raw_topic" value="/test_yaw_control/on/actual_setpoint" />
    <param name="setpoint_preview_topic" value="/test_yaw_control/on/preview" />
    <param name="enable_setpoint_output" value="false" />
    <param name="enable_yaw_control" value="true" />
    <param name="aligned_hold_sec" value="0.25" />
    <remap from="/front_marker_tracking/marker_pose_camera" to="/test_yaw_control/on/marker_pose_camera" />
    <remap from="/front_marker_tracking/position_error_camera" to="/test_yaw_control/on/position_error_camera" />
    <remap from="/front_marker_tracking/yaw_error" to="/test_yaw_control/on/yaw_error" />
    <remap from="/front_marker_tracking/error_flu" to="/test_yaw_control/on/error_flu" />
    <remap from="/front_marker_tracking/error_flu_filtered" to="/test_yaw_control/on/error_flu_filtered" />
    <remap from="/front_marker_tracking/cmd_vel_camera" to="/test_yaw_control/on/cmd_vel_camera" />
    <remap from="/front_marker_tracking/cmd_vel_flu" to="/test_yaw_control/on/cmd_vel_flu" />
    <remap from="/front_marker_tracking/status" to="/test_yaw_control/on/status" />
  </node>

  <test test-name="yaw_control_switch"
        pkg="front_marker_tracking"
        type="test_yaw_control_switch.py"
        time-limit="20.0" />
</launch>
