<launch>
  <node pkg="front_marker_tracking"
        type="front_marker_tracking_node"
        name="front_marker_tracking_node"
        clear_params="true"
        output="screen">
    <rosparam command="load" file="$(find front_marker_tracking)/config/front_usb_camera_aligned.yaml" />
    <param name="transform_topic" value="/test_front_marker_pid/transform" />
    <param name="state_topic" value="/test_front_marker_pid/state" />
    <param name="setpoint_raw_topic" value="/mavros/setpoint_raw/local" />
    <param name="setpoint_preview_topic" value="/test_front_marker_pid/setpoint_preview" />
    <param name="base_frame" value="base_link" />
    <param name="camera_optical_frame" value="usb_camera_optical_frame" />
    <param name="target_marker_id" value="33" />
    <param name="enable_setpoint_output" value="false" />
  </node>

  <test test-name="sample_driven_tracking"
        pkg="front_marker_tracking"
        type="test_sample_driven_tracking.py"
        time-limit="20.0" />
</launch>
