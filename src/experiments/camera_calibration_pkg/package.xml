<?xml version="1.0"?>
<package format="2">
  <name>camera_calibration_pkg</name>
  <version>0.1.0</version>
  <description>OV13855 monocular intrinsic calibration wrapper around camera_calibration for ROS Noetic.</description>

  <maintainer email="junhengsect+1647307223@qq.com">zjh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>camera_calibration</exec_depend>
  <exec_depend>ov13855_cam</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>poppler-utils</test_depend>
  <export/>
</package>
