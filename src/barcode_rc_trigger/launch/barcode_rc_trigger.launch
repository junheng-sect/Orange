<launch>
  <!-- 只启动触发节点；读码节点（barcode_reader_camera / barcode_reader_serial）和 MAVROS 需另外启动。
       mode 留空则用 yaml 里的 mode。 -->
  <arg name="config_file" default="$(find barcode_rc_trigger)/config/barcode_rc_trigger.yaml" />
  <arg name="mode" default="" />
  <node pkg="barcode_rc_trigger" type="barcode_rc_trigger_node" name="barcode_rc_trigger" output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param if="$(eval arg('mode') != '')" name="mode" value="$(arg mode)" />
  </node>
</launch>
