<launch>
  <!-- 手动读码：拨一下遥控器 CH9 读一次码，终端打印汇总，结果记进 ~/barcode_rc_logs/rc_read_<时间>.csv。
       默认配合 mid360s_ws/scripts/fusion.sh（fusion 已起 MAVROS、相机、AprilTag）；不跑 fusion 时加 camera:=true，MAVROS 另起。
       每个参数的可选值见下面的 doc（命令行列出全部参数的方法见 README「快速开始」）。
       注意：camera:=false 时 AprilTag 用 fusion 的 tag 43.7 mm，layout 只能是 qr_top_tag_bottom / dm_top_tag_bottom；
       mode 含 serial 时不要同时运行 DroneVision（共用 /dev/ttyS1）。 -->
  <arg name="mode" default="camera"
       doc="读码器：camera（只相机，默认）/ serial（只串口读码器）/ both（先相机后读码器，两个都读）" />
  <arg name="layout" default="qr_top_tag_bottom"
       doc="标签版式：qr_top_tag_bottom（QR 标签，默认）/ dm_top_tag_bottom（DataMatrix 标签）/ drone_vision_default（原版，tag 12 mm，需 camera:=true）" />
  <arg name="camera" default="false"
       doc="相机和 AprilTag 谁来起：false（fusion 已起，默认）/ true（本 launch 起，不跑 fusion 的地面测试）" />
  <arg name="save_frames" default="off"
       doc="相机读码存图：off（不存，默认）/ failed（只存失败）/ all（都存）；每次一个目录 save_dir/时间_结果/" />
  <arg name="save_dir" default="~/barcode_frames"
       doc="存图目录，attempts.csv（每次读码一行）也在这里" />
  <arg name="quiet" default="true"
       doc="true（默认，终端只留每次拨杆汇总和 WARN/ERROR）/ false（所有节点日志都打到终端）" />
  <arg name="config_file" default="$(find barcode_rc_trigger)/config/barcode_rc_trigger.yaml"
       doc="触发节点参数文件（CH9 阈值、CSV 目录等）" />
  <arg name="reader_output" value="$(eval 'log' if arg('quiet') else 'screen')" />

  <include if="$(arg camera)" file="$(find barcode_reader_camera)/launch/bringup.launch">
    <arg name="layout" value="$(arg layout)" />
    <arg name="output" value="$(arg reader_output)" />
    <arg name="save_frames" value="$(arg save_frames)" />
    <arg name="save_dir" value="$(arg save_dir)" />
  </include>
  <include unless="$(arg camera)" file="$(find barcode_reader_camera)/launch/barcode_reader_camera.launch">
    <arg name="layout" value="$(arg layout)" />
    <arg name="output" value="$(arg reader_output)" />
    <arg name="save_frames" value="$(arg save_frames)" />
    <arg name="save_dir" value="$(arg save_dir)" />
  </include>
  <include unless="$(eval arg('mode') == 'camera')" file="$(find barcode_reader_serial)/launch/barcode_reader.launch">
    <arg name="output" value="$(arg reader_output)" />
  </include>
  <include file="$(find barcode_rc_trigger)/launch/barcode_rc_trigger.launch">
    <arg name="config_file" value="$(arg config_file)" />
    <arg name="mode" value="$(arg mode)" />
  </include>
</launch>
