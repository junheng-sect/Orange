<launch>
  <node pkg="front_marker_vision"
        type="front_marker_vision_node"
        name="front_marker_tf_publication_test_vision"
        clear_params="true"
        output="screen">
    <param name="image_topic" value="/test_marker_tf/image" />
    <param name="camera_info_topic" value="/test_marker_tf/camera_info" />
    <param name="pose_topic" value="/test_marker_tf/pose" />
    <param name="transform_debug_topic" value="/test_marker_tf/transform_debug" />
    <param name="processing_time_topic" value="/test_marker_tf/processing_time" />
    <param name="annotated_image_topic" value="/test_marker_tf/annotated" />
    <param name="status_topic" value="/test_marker_tf/status" />
    <param name="aruco_dictionary" value="DICT_5X5_1000" />
    <param name="target_marker_id" value="33" />
    <param name="target_marker_size_m" value="0.070" />
    <param name="publish_marker_tf" value="true" />
    <param name="marker_frame" value="test_front_marker" />
    <param name="enable_contour_gate" value="false" />
    <param name="pose_solver" value="LEGACY" />
    <param name="publish_annotated" value="false" />
  </node>

  <test test-name="marker_tf_publication"
        pkg="front_marker_vision"
        type="test_marker_tf_publication.py"
        time-limit="15.0" />
</launch>
