<launch>
  <!-- 综合跟踪入口：各包运行参数统一由各包 YAML 维护，本 launch 只负责
       组合启动与场景选择（相机编码 mono8、场景差异配置路径）。 -->
  <arg name="camera_config" default="$(find ov9281_usb_cam)/config/ov9281_common.yaml" />
  <arg name="camera_scene_config" default="$(find ov9281_usb_cam)/config/ov9281_mono8.yaml" />
  <arg name="camera_tf_config" default="$(find front_marker_control)/config/front_camera_tf.yaml" />
  <arg name="vision_config" default="$(find front_marker_vision)/config/front_marker_vision.yaml" />
  <arg name="control_config" default="$(find front_marker_control)/config/front_marker_control.yaml" />
  <arg name="control_scene_config" default="" />

  <include file="$(find ov9281_usb_cam)/launch/ov9281.launch">
    <arg name="run_config" value="$(arg camera_config)" />
    <arg name="scene_config" value="$(arg camera_scene_config)" />
  </include>

  <include file="$(find front_marker_control)/launch/front_camera_tf.launch">
    <arg name="config_file" value="$(arg camera_tf_config)" />
  </include>

  <include file="$(find front_marker_vision)/launch/front_marker_vision.launch">
    <arg name="config_file" value="$(arg vision_config)" />
  </include>

  <include file="$(find front_marker_control)/launch/front_marker_control.launch">
    <arg name="config_file" value="$(arg control_config)" />
    <arg name="scene_config" value="$(arg control_scene_config)" />
  </include>
</launch>
