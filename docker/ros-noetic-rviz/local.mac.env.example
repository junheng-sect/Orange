# Mac only: copy to local.mac.env if needed. Ubuntu continues using local.env.
# Bash assignments; command-line arguments take precedence. Empty means default.
RVIZ_ROS_MASTER=""
RVIZ_ROS_IP=""
BOARD_IP=""
RVIZ_CONTAINER_NAME=""
RVIZ_IMAGE_TAG=""
RVIZ_CONFIG=""
RVIZ_WEB_PORT=6080
# Optional EGO overrides for the Mac-only entry.
EGO_RVIZ_IMAGE=""
EGO_RVIZ_WEB_PORT=6081

# ROS master on ros0; ordered board Wi-Fi addresses, separated by spaces.
ORANGE_ROS_MASTER_IP=""
BOARD_WIFI_IPS=""
# Car rosbridge hostname or IP (default spirit.local).
CAR_HOST=""
