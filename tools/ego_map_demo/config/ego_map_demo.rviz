Panels:
- Class: rviz/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded: []
    Splitter Ratio: 0.72
  Tree Height: 441
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.35
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Min Value: -0.5
      Max Value: 10.0
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 155; 155; 155
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Today map
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: true
    Size (Pixels): 1
    Size (m): 0.05
    Style: Points
    Topic: /ego_demo/map
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 0.6
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Min Value: -0.5
      Max Value: 10.0
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz/PointCloud2
    Color: 30; 100; 220
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Obstacles at flight height
    Position Transformer: XYZ
    Queue Size: 1
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.2
    Style: Boxes
    Topic: /ego_demo/obstacles_at_height
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Buffer Length: 1
    Class: rviz/Path
    Color: 0; 170; 30
    Enabled: true
    Head Diameter: 0.30000001192092896
    Head Length: 0.20000000298023224
    Length: 0.30000001192092896
    Line Style: Billboards
    Line Width: 0.18
    Name: EGO planned curve
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 255; 85; 255
    Pose Style: None
    Queue Size: 10
    Radius: 0.029999999329447746
    Shaft Diameter: 0.10000000149011612
    Shaft Length: 0.10000000149011612
    Topic: /ego_demo/path
    Unreliable: false
    Value: true
  - Class: rviz/Marker
    Name: Start and goal
    Enabled: true
    Marker Topic: /ego_demo/markers
    Queue Size: 30
    Namespaces:
      demo: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz/Interact
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  - Class: rviz/FocusCamera
  - Class: rviz/Measure
  - Class: rviz/SetGoal
    Topic: /ego_demo/goal_click
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 17.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0.0
        Y: 2.0
        Z: 1.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.0
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: []
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 900
  Width: 1400
  X: 80
  Y: 80
  Hide Left Dock: false
  Hide Right Dock: false
