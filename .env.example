# Copy this file to .env (ignored by Git) and fill in machine-local values.
ORANGE_SSH_HOST=orange
# Relative to the SSH login home, or an absolute path on the board.
ORANGE_REMOTE_ROOT="~/orange"
ORANGE_SUDO_PASSWORD=
ORANGE_ROS_MASTER_IP=
CAR_ROSBRIDGE_URL=ws://<car-ip>:9090
LOG_ANALYSIS_DIR="/path/to/Log analysis"
OBSIDIAN_ROOT="/path/to/Obsidian"
